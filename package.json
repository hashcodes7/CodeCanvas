{
    "name": "codecanvas",
    "displayName": "CodeCanvas",
    "description": "A new VS Code extension",
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.96.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onCustomEditor:codecanvas.codeCanvas"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "customEditors": [
            {
                "viewType": "codecanvas.codeCanvas",
                "displayName": "Code Canvas",
                "selector": [
                    {
                        "filenamePattern": "*.codecanvas"
                    }
                ],
                "priority": "default"
            }
        ],
        "commands": [
            {
                "command": "codecanvas.start",
                "title": "Start CodeCanvas"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/vscode": "^1.96.0",
        "@types/mocha": "^10.0.6",
        "@types/node": "20.x",
        "@typescript-eslint/eslint-plugin": "^8.10.0",
        "@typescript-eslint/parser": "^8.7.0",
        "eslint": "^9.13.0",
        "typescript": "^5.6.3",
        "@vscode/test-cli": "^0.0.10",
        "@vscode/test-electron": "^2.4.1"
    }
}